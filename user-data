#cloud-config
autoinstall:
  version: 1
  keyboard:
    layout: us
  locale: en_ZA.UTF-8
  shutdown: reboot
  storage:
    layout:
      name: lvm
      policy: all
  timezone: Africa/Johannesburg
  hostname: nrf-sarao
  users: ['']
  packages:
    - curl
    - dconf-cli
    - gh
    - git
    - vim

  late-commands:
    # Wallpapers
    - curtin in-target -- mkdir -p /usr/share/backgrounds/sarao /etc/dconf/db/local.d /etc/dconf/db/gdm.d
    - >-
      curtin in-target -- curl -s
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/meerkat-sky.jpg
      -o /usr/share/backgrounds/sarao/meerkat-sky.jpg
    - >-
      curtin in-target -- curl -s
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/00-sarao-bg
      -o /etc/dconf/db/local.d/00-sarao
    - >-
      curtin in-target -- curl -s
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/01-sarao-gdm
      -o /etc/dconf/db/gdm.d/01-sarao-gdm
    # Check whether necessary
    #- >-
