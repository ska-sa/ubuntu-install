#cloud-config
autoinstall:
  version: 1
  keyboard:
    layout: us
  locale: en_ZA.UTF-8
  shutdown: reboot
  storage:
    layout:
      name: lvm
      sizing-policy: all
  timezone: Africa/Johannesburg
  packages:
    - curl
    - dconf-cli
    - gh
    - git
    - vim

  user-data:
    hostname: nrf-sarao
    users: ['']

  late-commands:
    # Wallpaper (desktop only — GDM background dropped, not worth the fragility)
    - curtin in-target -- mkdir -p
      /usr/share/backgrounds/sarao
      /etc/dconf/db/local.d
    - >-
      curtin in-target -- curl -s
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/meerkat-sky.jpg
      -o /usr/share/backgrounds/sarao/meerkat-sky.jpg
    - >-
      curtin in-target -- curl -s
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/00-sarao
      -o /etc/dconf/db/local.d/00-sarao
    - >-
      curtin in-target -- bash -c
      "[ -f /etc/dconf/profile/user ] ||
      printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user"
    - curtin in-target -- dconf update
