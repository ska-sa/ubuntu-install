#cloud-config
autoinstall:
  version: 1
  keyboard:
    layout: us
  locale: en_ZA.UTF-8
  network:
    version: 2
    renderer: NetworkManager
    ethernets:
      enp*:
        dhcp4: true
        optional: true
    wifis:
      wlp*:
        access-points:
          "SARAO_Guest":
            password: "WIFI_PASSWORD"
        dhcp4: true
        optional: true
  shutdown: reboot
  storage:
    layout:
      name: lvm
      sizing-policy: all
  timezone: Africa/Johannesburg
  packages:
    - cups
    - curl
    - dconf-cli
    - gh
    - git
    - vim
  user-data:
    hostname: sarao
    users: ['']

  late-commands:
    # Chrome
    - >-
      curtin in-target -- curl -fsS --retry 3 --retry-delay 5
      -o /tmp/chrome.deb
      https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
    - curtin in-target -- apt-get install -fy /tmp/chrome.deb
    # EduVPN
    - >-
      curtin in-target -- bash -c
      "curl -fsS https://app.eduvpn.org/linux/v4/deb/app+linux@eduvpn.org.asc | gpg --dearmor -o /usr/share/keyrings/eduvpn-v4.gpg"
    - >-
      curtin in-target -- bash -c
      "echo 'deb [arch=amd64 signed-by=/usr/share/keyrings/eduvpn-v4.gpg] https://app.eduvpn.org/linux/v4/deb/ noble main' > /etc/apt/sources.list.d/eduvpn-v4.list"
    - curtin in-target -- apt-get update
    - curtin in-target -- apt-get install -fy eduvpn-client
    # GetEduroam
    - >-
      curtin in-target -- curl -fsS --retry 3 --retry-delay 5
      -o /tmp/geteduroam.deb
      https://github.com/geteduroam/linux-app/releases/download/0.14/geteduroam-gui_linux_amd64.deb
    - curtin in-target -- apt-get install -fy /tmp/geteduroam.deb
    # Mattermost
    - curtin in-target -- curl -fsS https://deb.packages.mattermost.com/setup-repo.sh -o /tmp/mm-repo.sh
    - curtin in-target -- bash /tmp/mm-repo.sh
    - curtin in-target -- apt-get install -fy mattermost-desktop
    # Zoom
    - >-
      curtin in-target -- curl -fsS --retry 3 --retry-delay 5
      -o /tmp/zoom.deb
      https://zoom.us/client/latest/zoom_amd64.deb
    - curtin in-target -- apt-get install -fy /tmp/zoom.deb
    # Printers
    - curtin in-target -- mkdir -p /target/usr/local/share/sarao-printers
    - curtin in-target -- cp /cdrom/nocloud/KOC751iUX.ppd /target/usr/local/share/sarao-printers/
    - >-
      curtin in-target -- bash -c
      "cat > /usr/local/bin/sarao-setup-printers.sh" <<'EOF'
      #!/bin/bash
      lpadmin -p LH0-East -E -v lpd://katscan1.kat.ac.za/print   -P /usr/local/share/sarao-printers/KOC751iUX.ppd -L "Liesbeek House Ground Floor East" -D "LH0-East"
      lpadmin -p LH0-West -E -v lpd://katscan2.kat.ac.za/print   -P /usr/local/share/sarao-printers/KOC751iUX.ppd -L "Liesbeek House Ground Floor West" -D "LH0-West"
      lpadmin -p LH1-East -E -v lpd://katscan4.kat.ac.za/print   -P /usr/local/share/sarao-printers/KOC751iUX.ppd -L "Liesbeek House 1st Floor East"    -D "LH1-East"
      lpadmin -p LH1-West -E -v lpd://katscanfin.kat.ac.za/print -P /usr/local/share/sarao-printers/KOC751iUX.ppd -L "Liesbeek House 1st Floor West"    -D "LH1-West"
      lpadmin -p LH2-East -E -v lpd://katscan3.kat.ac.za/print   -P /usr/local/share/sarao-printers/KOC751iUX.ppd -L "Liesbeek House 2nd Floor East"    -D "LH2-East"
      lpadmin -p LH2-West -E -v lpd://katscan.kat.ac.za/print    -P /usr/local/share/sarao-printers/KOC751iUX.ppd -L "Liesbeek House 2nd Floor West"    -D "LH2-West"
      EOF
    - curtin in-target -- chmod +x /usr/local/bin/sarao-setup-printers.sh
    - >-
      curtin in-target -- bash -c
      "cat > /etc/systemd/system/sarao-printers-setup.service" <<'EOF'
      [Unit]
      Description=SARAO one-time printer queue setup
      Wants=cups.service
      After=cups.service
      ConditionPathExists=!/var/lib/sarao/printers-configured

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/sarao-setup-printers.sh
      ExecStartPost=/usr/bin/mkdir -p /var/lib/sarao
      ExecStartPost=/usr/bin/touch /var/lib/sarao/printers-configured

      [Install]
      WantedBy=multi-user.target
      EOF
    - curtin in-target -- systemctl enable sarao-printers-setup.service
    # Wallpaper (desktop only — GDM background dropped, not worth the fragility)
    - curtin in-target -- mkdir -p
      /usr/share/backgrounds/sarao
      /etc/dconf/db/local.d
      >>/var/log/sarao-late-commands.log 2>&1 || true"
    - >-
      curtin in-target -- curl -fsS --retry 3 --retry-delay 5
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/meerkat-sky.jpg
      -o /usr/share/backgrounds/sarao/meerkat-sky.jpg
      >>/var/log/sarao-late-commands.log 2>&1 || true"
    - >-
      curtin in-target -- curl -fsS --retry 3 --retry-delay 5
      https://raw.githubusercontent.com/ska-sa/ubuntu-install/main/00-sarao
      -o /etc/dconf/db/local.d/00-sarao
      >>/var/log/sarao-late-commands.log 2>&1 || true"
    - >-
      curtin in-target -- bash -c
      "[ -f /etc/dconf/profile/user ] ||
      printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user"
      >>/var/log/sarao-late-commands.log 2>&1 || true"
    - curtin in-target -- dconf update
      >>/var/log/sarao-late-commands.log 2>&1 || true"
    # IT Administrator user 999 with passwordless sudo
    - curtin in-target -- useradd -m -u 999 -c "SARAO IT Administrators" -s /bin/bash itadmin
    - >-
      curtin in-target -- usermod -aG
      sudo,adm,cdrom,dip,plugdev,lpadmin,sambashare,netdev,audio,video,lxd itadmin
    - >-
      echo "itadmin:$(cat /cdrom/nocloud/itadmin.hash)" | curtin in-target -- chpasswd -e
    - curtin in-target -- mkdir -p /var/lib/AccountsService/users
    - >-
      curtin in-target -- bash -c
      "printf '[User]\nSystemAccount=true\n' > /var/lib/AccountsService/users/itadmin"
    - >-
      curtin in-target -- bash -c
      "printf 'itadmin ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/itadmin && chmod 0440 /etc/sudoers.d/itadmin"
    # SSH hardening make doubly sure there is no root ssh login allowed with passsword.
    - curtin in-target -- mkdir -p /etc/ssh/sshd_config.d
    - >-
      curtin in-target -- bash -c
      "printf 'PasswordAuthentication no\nPermitRootLogin no\n' > /etc/ssh/sshd_config.d/99-sarao-harden.conf"
